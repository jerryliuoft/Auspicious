{
  "manifest_version": 3,
  "name": "Auspicious: Daily Work Almanac",
  "short_name": "Auspicious",
  "version": "0.1.0",
  "description": "Tear off a new almanac page every day: personalized work fortunes, lucky hours, and remedies for unlucky days.",
  "minimum_chrome_version": "127",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Auspicious",
    "default_popup": "fortune.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "settings.html",
  "permissions": ["storage", "idle"],
  "optional_host_permissions": ["https://*/*"]
}
